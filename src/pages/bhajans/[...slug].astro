---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('bhajans')).map(entry => ({ params: { slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} — Hindu Companion`} description={entry.data.description}><article class="prose"><div class="eyebrow">{entry.data.language} · {entry.data.category}</div><h1>{entry.data.title}</h1>{entry.data.titleOriginal && <p class="lead">{entry.data.titleOriginal}</p>}<p class="notice"><strong>Source note:</strong> {entry.data.source}</p><Content /></article></BaseLayout>
