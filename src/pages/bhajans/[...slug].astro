---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const bhajans = await getCollection('bhajans');
  // ONLY 'published' status generates a public static page
  return bhajans
    .filter(entry => entry.data.status === 'published')
    .map(entry => ({
      params: { slug: entry.slug },
      props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} — Hindu Companion`} description={entry.data.description}>
  <article class="prose">
    <div class="eyebrow" style="margin-bottom: .5rem;">{entry.data.language} · {entry.data.category} · {entry.data.deity}</div>

    <h1>{entry.data.title}</h1>
    {entry.data.titleOriginal && <p class="lead" style="font-family: var(--serif); font-size: 1.4rem; color: var(--maroon);">{entry.data.titleOriginal}</p>}

    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="tags-row" style="margin-bottom: 1.5rem;">
        <span style="font-size: .85rem; font-weight: 700; color: var(--muted); align-self: center;">Tags:</span>
        {entry.data.tags.map((tag: string) => <span class="tag-pill">#{tag}</span>)}
      </div>
    )}

    {entry.data.transliteration && (
      <div class="notice" style="margin-bottom: 1.5rem;">
        <strong>Transliteration:</strong>
        <p style="margin: .3rem 0 0; font-style: italic;">{entry.data.transliteration}</p>
      </div>
    )}

    {entry.data.englishMeaning && (
      <div class="notice" style="margin-bottom: 1.5rem; border-left-color: var(--saffron);">
        <strong>Meaning:</strong>
        <p style="margin: .3rem 0 0;">{entry.data.englishMeaning}</p>
      </div>
    )}

    <p class="notice"><strong>Source:</strong> {entry.data.source}</p>

    <div class="entry-content" style="margin-top: 2rem;">
      <Content />
    </div>
  </article>
</BaseLayout>
