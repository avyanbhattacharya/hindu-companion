---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';
const featured = (await getCollection('bhajans')).filter(({ data }) => data.featured).slice(0, 2);
const guides = (await getCollection('guides')).slice(0, 2);
---
<BaseLayout title="Hindu Companion — Learn, listen, observe" description="A calm Hindu companion for devotional music, festival guides, and thoughtful daily practice.">
  <section class="hero">
    <div class="eyebrow">A Hindu resource for home and heart</div>
    <h1>Make space for daily devotion.</h1>
    <p class="lead">Discover bhajans with meaning, family-friendly festival guides, and a location-aware calendar experience—built to stay simple, private, and useful.</p>
    <div class="actions"><a class="button" href="bhajans/">Explore bhajans</a><a class="button secondary" href="calendar/">View the calendar</a></div>
  </section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">Start here</div><h2>Today’s companion</h2></div><p>Small, meaningful ways to begin.</p></div>
    <div class="grid"><article class="card"><div class="meta">Calendar</div><h3>Observe with care</h3><p>See the current curated calendar experience and learn why local timing matters.</p><a class="meta" href="calendar/">Open calendar →</a></article><article class="card"><div class="meta">At home</div><h3>Prepare a simple kirtan</h3><p>Choose a prayer, sing together, and let the practice fit your household.</p><a class="meta" href="bhajans/">Choose a bhajan →</a></article><article class="card"><div class="meta">For families</div><h3>Learn a festival story</h3><p>Gentle guides made for learning, preparation, and conversation.</p><a class="meta" href="guides/">Browse guides →</a></article></div>
  </section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">Listen and learn</div><h2>Featured bhajans</h2></div></div><div class="grid">{featured.map(item => <ContentCard href={`/bhajans/${item.slug}`} title={item.data.title} original={item.data.titleOriginal} meta={`${item.data.language} · ${item.data.category}`} description={item.data.description} />)}</div></section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">Celebrate together</div><h2>Festival guides</h2></div></div><div class="grid">{guides.map(item => <ContentCard href={`/guides/${item.slug}`} title={item.data.title} meta={item.data.festival} description={item.data.description} />)}</div></section>
</BaseLayout>
