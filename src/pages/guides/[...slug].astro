---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('guides')).map(entry => ({ params: { slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} — Hindu Companion`} description={entry.data.description}><article class="prose"><div class="eyebrow">{entry.data.festival}</div><h1>{entry.data.title}</h1><p class="lead">{entry.data.subtitle}</p><p class="notice"><strong>Source note:</strong> {entry.data.source}</p><Content /></article></BaseLayout>
