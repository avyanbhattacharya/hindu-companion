---
const { href, title, original, meta, description, status, tags, transliteration, language } = Astro.props;
const depth = Astro.url.pathname.split('/').filter(Boolean).length;
const internalHref = `${'../'.repeat(depth)}${href.replace(/^\//, '')}/`;

const badgeLabels = {
  'verified': 'Verified',
  'draft': 'Draft',
  'needs-review': 'Needs Review',
  'not-published': 'Not Published'
};
---
<article class="card" data-title={title?.toLowerCase()} data-original={original?.toLowerCase()} data-language={language} data-tags={tags?.join(',').toLowerCase()} data-status={status}>
  <div class="card-header">
    <div class="meta">{meta}</div>
    {status && <span class={`badge badge-${status}`}>{badgeLabels[status] || status}</span>}
  </div>
  <h3><a href={internalHref}>{title}</a></h3>
  {original && <div class="card-original">{original}</div>}
  {transliteration && <p class="card-transliteration"><em>{transliteration}</em></p>}
  <p>{description}</p>
  {tags && tags.length > 0 && (
    <div class="tags-row">
      {tags.map((tag: string) => <span class="tag-pill">#{tag}</span>)}
    </div>
  )}
  <div class="meta-row" style="margin-top: auto; padding-top: .5rem;">
    <a class="meta" href={internalHref}>Read and practice →</a>
  </div>
</article>
